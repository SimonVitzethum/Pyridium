{
  "name": "Arc Realism",
  "version": "0.1",
  "abi": 1,
  "author": "Pyridium",
  "license": "GPL-3.0-or-later",
  "description": "Realistischer, physikalisch orientierter Look (Idee: Arc-Shader, MIT). Aktuell: filmische Antwortkurve und physikalischer Himmel; weitere Stages folgen mit dem Portieren der Beleuchtung.",
  "options": [
    { "id": "film", "type": "float", "min": 0.0, "max": 1.0, "default": 0.6, "label": "Filmische Kurve (0 = linear mit Schulter)" },
    { "id": "saturation", "type": "float", "min": 0.6, "max": 1.4, "default": 1.0, "label": "Saettigung" },
    { "id": "shoulder", "type": "float", "min": 0.5, "max": 0.95, "default": 0.7, "label": "Schulter" },
    { "id": "sky_ms", "type": "float", "min": 1.0, "max": 3.0, "default": 1.7, "label": "Himmelshelligkeit (Mehrfachstreuung)" },
    { "id": "stars", "type": "float", "min": 0.0, "max": 3.0, "default": 1.0, "label": "Sterne (Nacht)" }
  ]
}
